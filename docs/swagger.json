    "definitions": {
        "handler.createCategoryRequest": {
            "type": "object",
            "required": [
                "name",
                "type"
            ],
            "properties": {
                "icon_name": {
                    "type": "string",
                    "example": "coffee"
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "example": "Kopi"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "INCOME",
                        "EXPENSE"
                    ],
                    "example": "EXPENSE"
                }
            }
        },
        "handler.createGoalRequest": {
            "type": "object",
            "required": [
                "target_amount",
                "title"
            ],
            "properties": {
                "target_amount": {
                    "type": "integer",
                    "example": 5000000
                },
                "target_date": {
                    "type": "string",
                    "example": "2026-12-20"
                },
                "title": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 1,
                    "example": "Liburan ke Bali"
                }
            }
        },
        "handler.createTransactionRequest": {
            "type": "object",
            "required": [
                "amount",
                "type",
                "wallet_id"
            ],
            "properties": {
                "amount": {
                    "type": "integer",
                    "example": 25000
                },
                "category_id": {
                    "type": "string",
                    "example": "0f2b1a3c-1111-4a2b-8c3d-000000000002"
                },
                "description": {
                    "type": "string",
                    "maxLength": 500,
                    "example": "Makan siang di warung"
                },
                "trx_date": {
                    "type": "string",
                    "example": "2026-10-01T09:00:00Z"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "INCOME",
                        "EXPENSE"
                    ],
                    "example": "EXPENSE"
                },
                "wallet_id": {
                    "type": "string",
                    "example": "0f2b1a3c-1111-4a2b-8c3d-000000000001"
                }
            }
        },
        "handler.fundGoalData": {
            "type": "object",
            "properties": {
                "goal": {
                    "$ref": "#/definitions/model.SavingGoal"
                },
                "transaction": {
                    "$ref": "#/definitions/handler.transactionResponse"
                }
            }
