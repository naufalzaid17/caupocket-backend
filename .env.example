# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Contoh koneksi via docker-compose.yml yang disediakan:
DATABASE_URL=postgres://caupocket:caupocket@localhost:5432/caupocket?sslmode=disable

# WAJIB minimal 16 karakter. Ganti dengan nilai acak di production.
JWT_SECRET=dev-only-change-me-32chars-minimum!!

# Opsional
PORT=8080
GIN_MODE=debug
JWT_EXPIRES_IN=72h

# OCR struk (EPIC V2.1) — binary Tesseract dipanggil sebagai subprocess.
# Di Windows biasanya: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_BIN=tesseract
TESSERACT_LANG=eng
OCR_TIMEOUT=30s

# Habit Engine (EPIC V2.2) — event bus & aturan reward.
# EVENT_BUS: memory (default, tanpa infrastruktur) | redis (Redis Pub/Sub).
# Catatan: pada container all-in-one (Dockerfile), default sudah
# EVENT_BUS=redis + REDIS_ADDR=127.0.0.1:6379 (Redis internal).
EVENT_BUS=memory
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
HABIT_STREAK_DAYS=3
HABIT_REWARD_AMOUNT=10000
