# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Contoh koneksi via docker-compose.yml yang disediakan:
DATABASE_URL=postgres://caupocket:caupocket@localhost:5432/caupocket?sslmode=disable

# WAJIB minimal 16 karakter. Ganti dengan nilai acak di production.
JWT_SECRET=dev-only-change-me-32chars-minimum!!

# Opsional
PORT=8080
GIN_MODE=debug
JWT_EXPIRES_IN=72h
